# 知一 2.0 · 忽略规则
# 说明：本仓库此前没有版本控制，构建快照与缓存长期堆积（曾一度堆到 129 MB / 45 个 dist 目录）。
# 这份规则的目的就是让「可重建的东西」永远不进版本库、也不再靠人工清理。

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物（全部可由源码重建）----------
# 部署用的是服务器上的 static，本地这些只是构建快照
dist/
dist*/
backend/static/
backend/static_bak_prev/

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ---------- 凭据（绝不入库）----------
# backend/.env 里是真实 API Key
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- 本地数据库（含账号 / 错题 / 题库数据）----------
backend/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- 临时产物 ----------
*.tar.gz
*.log
_cleanup_report.txt
.learnbuddy/_p9_shots*/
.learnbuddy/_p9_shots*/*
.tmp/
tmp/

# ---------- 编辑器 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
