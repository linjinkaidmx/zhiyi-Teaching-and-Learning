# 知一 2.0 · 忽略规则
#
# 原则：可重建的东西一律不进版本库。
# 曾出现过构建快照堆积（一度 129MB / 45 个 dist 目录），也出现过明文凭据被推上公开仓库，
# 因此下面按「依赖 / 产物 / 凭据 / 数据 / 临时 / 工作区 / 素材」分组，便于维护。

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物（全部可由源码重建）----------
dist/
dist*/
backend/static/
backend/static_bak_prev/
backend/static_bak*/
backend/static_tmp*/

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ---------- 凭据（绝不入库）----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- 本地数据库（含账号 / 错题 / 题库数据）----------
backend/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- 临时产物 ----------
*.tar.gz
*.log
*.tmp
*.timestamp-*.mjs
_cleanup_report.txt
_handbook*
.tmp/
tmp/

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- 工作区内部数据（任意层级：QA 截图、记忆、实验产物）----------
.learnbuddy/
**/.learnbuddy/
*_accounts.json
*_ab/
_legacy_removed/
_snapshot_*/

# ---------- 数据导出（走脚本重新生成，不入库）----------
*_dump.json
*bank_full*.json

# ---------- 本地存档（体积大 / 属交付材料，不进代码仓库）----------
参赛素材/
skills-export/
