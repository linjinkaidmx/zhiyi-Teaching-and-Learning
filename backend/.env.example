# 复制为 .env 并填写；.env 不入库
# ============================================================
# Provider 凭据（填一个即可跑通；讲解位想用 DeepSeek 再填第二个）
# ============================================================
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================================
# 三个调用位：provider(ark|deepseek) + model + thinking(0/1)
# 注意：model 带 *-turbo 的是快速版、一般不支持思考，请配 thinking=0；
#       想开思考 → 换成支持思考的模型名，或讲解位直接用 deepseek-reasoner
# 默认全方舟 turbo 全关思考（最稳，开箱即用）
# ============================================================
EXTRACT_PROVIDER=ark
EXTRACT_MODEL=doubao-seed-2-1-turbo-260628
EXTRACT_THINKING=0

EXPLAIN_PROVIDER=ark
EXPLAIN_MODEL=doubao-seed-2-1-turbo-260628
EXPLAIN_THINKING=0

JUDGE_PROVIDER=ark
JUDGE_MODEL=doubao-seed-2-1-turbo-260628
JUDGE_THINKING=0

# ============================================================
# ▶ 高性能预设（不计成本：讲解最准确 + 识别/批改最快）
# 取消下面 4 行注释即可，覆盖同名的 ark 默认值：
# ============================================================
# EXPLAIN_PROVIDER=deepseek
# EXPLAIN_MODEL=deepseek-reasoner        # DeepSeek-R1，数学推理国内第一梯队
# JUDGE_PROVIDER=deepseek
# JUDGE_MODEL=deepseek-chat              # DeepSeek-V3，快且准

# 讲解位失败时是否降级到方舟 turbo（不开思考）重试，0 关闭
EXPLAIN_FALLBACK=1

# 置 1 强制走 Mock（不配任何 Key 时也会自动走 Mock）
MOCK=0
